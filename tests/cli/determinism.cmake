# Fixed-step runs must repeat exactly: `victus simulate` of the arena sample (AI, navigation,
# physics and math.random-driven spawns) twice from the same scene must print identical state.
# Regression test for scripts that were seeded from the clock (math.random) in fixed-frame runs.
foreach(v VICTUS_CLI SOURCE_DIR WORK)
    if(NOT DEFINED ${v})
        message(FATAL_ERROR "determinism.cmake: -D${v}= is required")
    endif()
endforeach()
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
file(COPY "${SOURCE_DIR}/samples/arena" DESTINATION "${WORK}")
set(project "${WORK}/arena")
file(REMOVE_RECURSE "${project}/.victus")
execute_process(COMMAND "${VICTUS_CLI}" import "${project}" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE out)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "victus import failed (${rc}):\n${out}")
endif()
set(previous "")
foreach(run 1 2 3)
    execute_process(COMMAND "${VICTUS_CLI}" simulate "${project}" --scene scenes/autoplay.vscene --frames 240
                            --print "Player,Enemy Robot"
                    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "victus simulate run ${run} failed (${rc}):\n${out}\n${err}")
    endif()
    string(REGEX MATCHALL "[^\n]*Robot:[^\n]*|[^\n]*Player:[^\n]*" state "${out}")
    if(NOT state)
        message(FATAL_ERROR "victus simulate printed no entity state:\n${out}")
    endif()
    if(run GREATER 1 AND NOT state STREQUAL previous)
        message(FATAL_ERROR "fixed-step simulation is not deterministic:\nrun 1: ${previous}\nrun ${run}: ${state}")
    endif()
    set(previous "${state}")
endforeach()
message(STATUS "deterministic over 3 runs: ${previous}")
