# End-to-end CLI smoke test: create every template, inspect, import and (when a GPU is
# required, i.e. on Linux CI with lavapipe) run each project for a few frames with a screenshot.
#   cmake -DVICTUS_CLI=<victus> -DVICTUS_PLAYER=<victus_player> -DWORK=<dir> -P cli_smoke.cmake
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

function(run_ok)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "command failed (${rc}): ${ARGN}\n${out}\n${err}")
    endif()
    set(LAST_OUTPUT "${out}" PARENT_SCOPE)
endfunction()

run_ok("${VICTUS_CLI}" version)
if(NOT LAST_OUTPUT MATCHES "VICTUS [0-9]+\\.[0-9]+")
    message(FATAL_ERROR "unexpected version output: ${LAST_OUTPUT}")
endif()
run_ok("${VICTUS_CLI}" templates)
foreach(t 3d 2d simulation)
    if(NOT LAST_OUTPUT MATCHES "${t}")
        message(FATAL_ERROR "template ${t} missing from: ${LAST_OUTPUT}")
    endif()
endforeach()

# Unknown commands and missing projects must fail.
execute_process(COMMAND "${VICTUS_CLI}" no-such-command RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
if(rc EQUAL 0)
    message(FATAL_ERROR "unknown command succeeded")
endif()
execute_process(COMMAND "${VICTUS_CLI}" info "${WORK}/missing" RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
if(rc EQUAL 0)
    message(FATAL_ERROR "info on a missing project succeeded")
endif()

set(run_gpu OFF)
if("$ENV{VICTUS_REQUIRE_GPU}" STREQUAL "1" AND NOT "$ENV{VICTUS_NO_GPU}" STREQUAL "1")
    set(run_gpu ON)
endif()

foreach(t 3d 2d simulation)
    set(dir "${WORK}/game_${t}")
    run_ok("${VICTUS_CLI}" new "${dir}" --template ${t} --name "Smoke ${t}")
    if(NOT EXISTS "${dir}/victus.project" OR NOT EXISTS "${dir}/scenes/main.vscene")
        message(FATAL_ERROR "project files missing for ${t}")
    endif()
    # Creating into a non-empty folder must fail rather than overwrite.
    execute_process(COMMAND "${VICTUS_CLI}" new "${dir}" RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
    if(rc EQUAL 0)
        message(FATAL_ERROR "new overwrote an existing project")
    endif()
    run_ok("${VICTUS_CLI}" info "${dir}")
    if(NOT LAST_OUTPUT MATCHES "Smoke ${t}")
        message(FATAL_ERROR "info output missing name: ${LAST_OUTPUT}")
    endif()
    run_ok("${VICTUS_CLI}" import "${dir}")
    run_ok("${VICTUS_CLI}" check "${dir}")
    if(NOT LAST_OUTPUT MATCHES "0 problems")
        message(FATAL_ERROR "check reported problems for ${t}: ${LAST_OUTPUT}")
    endif()
    # Headless gameplay (no GPU): scripts run without errors.
    run_ok("${VICTUS_CLI}" simulate "${dir}" --frames 120 --hold D --print Player)
    if(NOT LAST_OUTPUT MATCHES " 0 script errors")
        message(FATAL_ERROR "simulate reported script errors for ${t}: ${LAST_OUTPUT}")
    endif()
    if(run_gpu)
        run_ok("${VICTUS_CLI}" run "${dir}" --strict --frames 5 --width 320 --height 180 --screenshot "${WORK}/run_${t}.png")
        if(NOT EXISTS "${WORK}/run_${t}.png")
            message(FATAL_ERROR "run did not write a screenshot for ${t}")
        endif()
    endif()
endforeach()

# A broken script is reported by check (exit 1) and by simulate (exit 3).
file(WRITE "${WORK}/game_2d/assets/scripts/broken.luau" "local M = {}\nfunction M:update(dt\nreturn M\n")
execute_process(COMMAND "${VICTUS_CLI}" check "${WORK}/game_2d" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_QUIET)
if(NOT rc EQUAL 1 OR NOT out MATCHES "broken.luau")
    message(FATAL_ERROR "check did not report the broken script (${rc}): ${out}")
endif()
file(REMOVE "${WORK}/game_2d/assets/scripts/broken.luau")
file(WRITE "${WORK}/game_2d/assets/scripts/coin.luau" "local M = {}\nfunction M:update(dt) error('boom') end\nreturn M\n")
execute_process(COMMAND "${VICTUS_CLI}" simulate "${WORK}/game_2d" --frames 5 RESULT_VARIABLE rc OUTPUT_QUIET ERROR_VARIABLE err)
if(NOT rc EQUAL 3 OR NOT err MATCHES "boom")
    message(FATAL_ERROR "simulate did not fail on a runtime script error (${rc}): ${err}")
endif()
run_ok("${VICTUS_CLI}" new "${WORK}/game_2d_clean" --template 2d)

if(run_gpu)
    # Packaged layout: player next to a game/ folder, no arguments.
    file(MAKE_DIRECTORY "${WORK}/package")
    get_filename_component(player_name "${VICTUS_PLAYER}" NAME)
    file(COPY "${VICTUS_PLAYER}" DESTINATION "${WORK}/package")
    file(COPY "${WORK}/game_2d_clean/" DESTINATION "${WORK}/package/game")
    run_ok("${WORK}/package/${player_name}" --frames 3 --screenshot "${WORK}/package.png")
    if(NOT EXISTS "${WORK}/package.png")
        message(FATAL_ERROR "packaged player did not write a screenshot")
    endif()
endif()
# `victus export`: every template becomes a runnable folder (player + game/game.vpak).
foreach(t 3d 2d simulation)
    set(dir "${WORK}/export_src_${t}")
    set(out "${WORK}/export_${t}")
    run_ok("${VICTUS_CLI}" new "${dir}" --template ${t} --name "Export ${t}")
    run_ok("${VICTUS_CLI}" export "${dir}" --out "${out}" --name "game_${t}")
    if(NOT LAST_OUTPUT MATCHES "exported [0-9]+ files")
        message(FATAL_ERROR "unexpected export output for ${t}: ${LAST_OUTPUT}")
    endif()
    foreach(f game/game.vpak export.json THIRD_PARTY_NOTICES.txt)
        if(NOT EXISTS "${out}/${f}")
            message(FATAL_ERROR "export of ${t} is missing ${f}")
        endif()
    endforeach()
    if(EXISTS "${out}/game/victus.project" OR EXISTS "${out}/game/assets")
        message(FATAL_ERROR "export of ${t} shipped loose project files")
    endif()
    file(GLOB exe "${out}/game_${t}*")
    if(NOT exe)
        message(FATAL_ERROR "export of ${t} did not copy the player")
    endif()
    # Re-export over the previous export is allowed.
    run_ok("${VICTUS_CLI}" export "${dir}" --out "${out}" --name "game_${t}")
    if(run_gpu)
        run_ok("${exe}" --frames 5 --screenshot "${WORK}/export_${t}.png")
        if(NOT EXISTS "${WORK}/export_${t}.png")
            message(FATAL_ERROR "exported ${t} game did not write a screenshot")
        endif()
    endif()
endforeach()
# Exporting a project with a broken script fails and names the script.
file(WRITE "${WORK}/export_src_2d/assets/scripts/broken.luau" "local M = {}\nfunction M:update(dt\nreturn M\n")
execute_process(COMMAND "${VICTUS_CLI}" export "${WORK}/export_src_2d" --out "${WORK}/export_broken" RESULT_VARIABLE rc
    OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(rc EQUAL 0 OR NOT err MATCHES "broken.luau")
    message(FATAL_ERROR "export did not fail on a broken script (${rc}): ${out}${err}")
endif()
execute_process(COMMAND "${VICTUS_CLI}" export "${WORK}/export_src_3d" RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
if(rc EQUAL 0)
    message(FATAL_ERROR "export without --out succeeded")
endif()

message(STATUS "CLI smoke test passed (gpu run: ${run_gpu})")
