# End-to-end CLI smoke test: create every template, inspect, import and (when a GPU is
# required, i.e. on Linux CI with lavapipe) run each project for a few frames with a screenshot.
#   cmake -DVICTUS_CLI=<victus> -DVICTUS_PLAYER=<victus_player> -DWORK=<dir> -P cli_smoke.cmake
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

function(run_ok)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "command failed (${rc}): ${ARGN}\n${out}\n${err}")
    endif()
    set(LAST_OUTPUT "${out}" PARENT_SCOPE)
endfunction()

run_ok("${VICTUS_CLI}" version)
if(NOT LAST_OUTPUT MATCHES "VICTUS [0-9]+\\.[0-9]+")
    message(FATAL_ERROR "unexpected version output: ${LAST_OUTPUT}")
endif()
run_ok("${VICTUS_CLI}" templates)
foreach(t 3d 2d simulation multiplayer)
    if(NOT LAST_OUTPUT MATCHES "${t}")
        message(FATAL_ERROR "template ${t} missing from: ${LAST_OUTPUT}")
    endif()
endforeach()

# Unknown commands and missing projects must fail.
execute_process(COMMAND "${VICTUS_CLI}" no-such-command RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
if(rc EQUAL 0)
    message(FATAL_ERROR "unknown command succeeded")
endif()
execute_process(COMMAND "${VICTUS_CLI}" info "${WORK}/missing" RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
if(rc EQUAL 0)
    message(FATAL_ERROR "info on a missing project succeeded")
endif()

set(run_gpu OFF)
if("$ENV{VICTUS_REQUIRE_GPU}" STREQUAL "1" AND NOT "$ENV{VICTUS_NO_GPU}" STREQUAL "1")
    set(run_gpu ON)
endif()

foreach(t 3d 2d simulation multiplayer)
    set(dir "${WORK}/game_${t}")
    run_ok("${VICTUS_CLI}" new "${dir}" --template ${t} --name "Smoke ${t}")
    if(NOT EXISTS "${dir}/victus.project" OR NOT EXISTS "${dir}/scenes/main.vscene")
        message(FATAL_ERROR "project files missing for ${t}")
    endif()
    # Creating into a non-empty folder must fail rather than overwrite.
    execute_process(COMMAND "${VICTUS_CLI}" new "${dir}" RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
    if(rc EQUAL 0)
        message(FATAL_ERROR "new overwrote an existing project")
    endif()
    run_ok("${VICTUS_CLI}" info "${dir}")
    if(NOT LAST_OUTPUT MATCHES "Smoke ${t}")
        message(FATAL_ERROR "info output missing name: ${LAST_OUTPUT}")
    endif()
    run_ok("${VICTUS_CLI}" import "${dir}")
    run_ok("${VICTUS_CLI}" check "${dir}")
    if(NOT LAST_OUTPUT MATCHES "0 problems")
        message(FATAL_ERROR "check reported problems for ${t}: ${LAST_OUTPUT}")
    endif()
    # Headless gameplay (no GPU): scripts run without errors.
    run_ok("${VICTUS_CLI}" simulate "${dir}" --frames 120 --hold D --print Player)
    if(NOT LAST_OUTPUT MATCHES " 0 script errors")
        message(FATAL_ERROR "simulate reported script errors for ${t}: ${LAST_OUTPUT}")
    endif()
    # The same through a gamepad's left stick (input actions).
    run_ok("${VICTUS_CLI}" simulate "${dir}" --frames 60 --hold Pad.LeftX+ --hold Pad.South)
    if(run_gpu)
        run_ok("${VICTUS_CLI}" run "${dir}" --strict --frames 5 --width 320 --height 180 --screenshot "${WORK}/run_${t}.png")
        if(NOT EXISTS "${WORK}/run_${t}.png")
            message(FATAL_ERROR "run did not write a screenshot for ${t}")
        endif()
        if(NOT LAST_OUTPUT MATCHES "at high quality")
            message(FATAL_ERROR "run did not use the project's default quality for ${t}: ${LAST_OUTPUT}")
        endif()
        # Every quality tier renders the template.
        foreach(q low medium ultra)
            run_ok("${VICTUS_CLI}" run "${dir}" --strict --frames 3 --width 320 --height 180 --quality ${q}
                   --screenshot "${WORK}/run_${t}_${q}.png")
            if(NOT LAST_OUTPUT MATCHES "at ${q} quality" OR NOT EXISTS "${WORK}/run_${t}_${q}.png")
                message(FATAL_ERROR "run --quality ${q} failed for ${t}: ${LAST_OUTPUT}")
            endif()
        endforeach()
        execute_process(COMMAND "${VICTUS_CLI}" run "${dir}" --frames 1 --quality cinematic
                        RESULT_VARIABLE rc OUTPUT_QUIET ERROR_VARIABLE err)
        if(rc EQUAL 0 OR NOT err MATCHES "unknown quality tier")
            message(FATAL_ERROR "run accepted an unknown quality tier (${rc}): ${err}")
        endif()
    endif()
endforeach()

# Multiplayer over real UDP on loopback: a dedicated server and two headless clients run
# concurrently; each exits non-zero unless both players met (server --expect-clients, clients
# --expect-players). One client runs over an emulated lossy, delayed link. ann stays longer than
# ben, so ben's final roster (the captured output of the last pipeline command) still lists her.
string(RANDOM LENGTH 3 ALPHABET 0123456789 port_suffix)
math(EXPR port "27100 + ${port_suffix}")
set(mp "${WORK}/game_multiplayer")
execute_process(
    COMMAND "${VICTUS_CLI}" serve "${mp}" --port ${port} --frames 480 --expect-clients 2
    COMMAND "${VICTUS_CLI}" simulate "${mp}" --connect 127.0.0.1:${port} --name ann --frames 380 --hold D --expect-players 2
            --conditions latency=40,jitter=10,loss=0.05
    COMMAND "${VICTUS_CLI}" simulate "${mp}" --connect 127.0.0.1:${port} --name ben --frames 300 --hold W --expect-players 2
    RESULTS_VARIABLE mp_rcs OUTPUT_VARIABLE mp_out ERROR_VARIABLE mp_err)
if(NOT mp_rcs STREQUAL "0;0;0")
    message(FATAL_ERROR "multiplayer session failed (exit codes ${mp_rcs}):\n${mp_out}\n${mp_err}")
endif()
if(NOT mp_out MATCHES "most players seen 2" OR NOT mp_out MATCHES "player [12] 'ann'")
    message(FATAL_ERROR "unexpected client output: ${mp_out}")
endif()
# A client of a different game is refused (exit 4).
run_ok("${VICTUS_CLI}" new "${WORK}/other_game" --template multiplayer --name "Other")
execute_process(
    COMMAND "${VICTUS_CLI}" serve "${mp}" --port ${port} --frames 180
    COMMAND "${VICTUS_CLI}" simulate "${WORK}/other_game" --connect 127.0.0.1:${port} --frames 120
    RESULTS_VARIABLE mp_rcs OUTPUT_VARIABLE mp_out ERROR_VARIABLE mp_err)
if(NOT mp_rcs STREQUAL "0;4" OR NOT mp_err MATCHES "different game")
    message(FATAL_ERROR "mismatched client was not rejected (${mp_rcs}): ${mp_out}${mp_err}")
endif()

# Unknown controls are refused: by --hold (exit 1) and in the project's input actions (check exit 1).
execute_process(COMMAND "${VICTUS_CLI}" simulate "${WORK}/game_2d" --frames 5 --hold Pad.Nope RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
if(NOT rc EQUAL 1)
    message(FATAL_ERROR "simulate accepted an unknown --hold control (${rc})")
endif()
file(READ "${WORK}/game_2d/victus.project" project_text)
string(REPLACE "\"Pad.South\"" "\"Pad.Soth\"" bad_project "${project_text}")
file(WRITE "${WORK}/game_2d/victus.project" "${bad_project}")
execute_process(COMMAND "${VICTUS_CLI}" check "${WORK}/game_2d" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 1 OR NOT "${out}${err}" MATCHES "Pad.Soth")
    message(FATAL_ERROR "check did not report the unknown input control (${rc}): ${out}${err}")
endif()
file(WRITE "${WORK}/game_2d/victus.project" "${project_text}")

# A broken script is reported by check (exit 1) and by simulate (exit 3).
file(WRITE "${WORK}/game_2d/assets/scripts/broken.luau" "local M = {}\nfunction M:update(dt\nreturn M\n")
execute_process(COMMAND "${VICTUS_CLI}" check "${WORK}/game_2d" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_QUIET)
if(NOT rc EQUAL 1 OR NOT out MATCHES "broken.luau")
    message(FATAL_ERROR "check did not report the broken script (${rc}): ${out}")
endif()
file(REMOVE "${WORK}/game_2d/assets/scripts/broken.luau")
# So is a behaviour tree that does not parse.
file(WRITE "${WORK}/game_2d/assets/ai/broken.vbt" "{\"root\": {\"type\": \"sequence\"}}")
execute_process(COMMAND "${VICTUS_CLI}" check "${WORK}/game_2d" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_QUIET)
if(NOT rc EQUAL 1 OR NOT out MATCHES "broken.vbt.*needs children")
    message(FATAL_ERROR "check did not report the broken behaviour tree (${rc}): ${out}")
endif()
file(REMOVE "${WORK}/game_2d/assets/ai/broken.vbt")
file(WRITE "${WORK}/game_2d/assets/scripts/coin.luau" "local M = {}\nfunction M:update(dt) error('boom') end\nreturn M\n")
execute_process(COMMAND "${VICTUS_CLI}" simulate "${WORK}/game_2d" --frames 5 RESULT_VARIABLE rc OUTPUT_QUIET ERROR_VARIABLE err)
if(NOT rc EQUAL 3 OR NOT err MATCHES "boom")
    message(FATAL_ERROR "simulate did not fail on a runtime script error (${rc}): ${err}")
endif()
# Controller problems that only show against the model are warnings: a root-motion node it lacks.
set(vanim "${WORK}/game_3d/assets/anim/characters/vanguard_locomotion.vanim")
file(READ "${vanim}" vanim_text)
string(REPLACE "\"name\": \"Fall\"" "\"name\": \"Fall\", \"root_motion\": true" bad_vanim "${vanim_text}")
string(REPLACE "\"default_state\"" "\"root_node\": \"Pelvis\", \"default_state\"" bad_vanim "${bad_vanim}")
file(WRITE "${vanim}" "${bad_vanim}")
execute_process(COMMAND "${VICTUS_CLI}" check "${WORK}/game_3d" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_QUIET)
if(NOT rc EQUAL 0 OR NOT out MATCHES "root motion from node 'Pelvis' that its model lacks")
    message(FATAL_ERROR "check did not warn about the missing root-motion node (${rc}): ${out}")
endif()
file(WRITE "${vanim}" "${vanim_text}")
run_ok("${VICTUS_CLI}" new "${WORK}/game_2d_clean" --template 2d)

if(run_gpu)
    # Packaged layout: player next to a game/ folder, no arguments.
    file(MAKE_DIRECTORY "${WORK}/package")
    get_filename_component(player_name "${VICTUS_PLAYER}" NAME)
    file(COPY "${VICTUS_PLAYER}" DESTINATION "${WORK}/package")
    file(COPY "${WORK}/game_2d_clean/" DESTINATION "${WORK}/package/game")
    run_ok("${WORK}/package/${player_name}" --frames 3 --screenshot "${WORK}/package.png")
    if(NOT EXISTS "${WORK}/package.png")
        message(FATAL_ERROR "packaged player did not write a screenshot")
    endif()
endif()
# `victus export`: every template becomes a runnable folder (player + game/game.vpak).
foreach(t 3d 2d simulation)
    set(dir "${WORK}/export_src_${t}")
    set(out "${WORK}/export_${t}")
    run_ok("${VICTUS_CLI}" new "${dir}" --template ${t} --name "Export ${t}")
    run_ok("${VICTUS_CLI}" export "${dir}" --out "${out}" --name "game_${t}")
    if(NOT LAST_OUTPUT MATCHES "exported [0-9]+ files")
        message(FATAL_ERROR "unexpected export output for ${t}: ${LAST_OUTPUT}")
    endif()
    foreach(f game/game.vpak export.json THIRD_PARTY_NOTICES.txt)
        if(NOT EXISTS "${out}/${f}")
            message(FATAL_ERROR "export of ${t} is missing ${f}")
        endif()
    endforeach()
    if(EXISTS "${out}/game/victus.project" OR EXISTS "${out}/game/assets")
        message(FATAL_ERROR "export of ${t} shipped loose project files")
    endif()
    file(GLOB exe "${out}/game_${t}*")
    if(NOT exe)
        message(FATAL_ERROR "export of ${t} did not copy the player")
    endif()
    # Re-export over the previous export is allowed.
    run_ok("${VICTUS_CLI}" export "${dir}" --out "${out}" --name "game_${t}")
    if(run_gpu)
        run_ok("${exe}" --frames 5 --screenshot "${WORK}/export_${t}.png")
        if(NOT EXISTS "${WORK}/export_${t}.png")
            message(FATAL_ERROR "exported ${t} game did not write a screenshot")
        endif()
    endif()
endforeach()
# Exporting a project with a broken script fails and names the script.
file(WRITE "${WORK}/export_src_2d/assets/scripts/broken.luau" "local M = {}\nfunction M:update(dt\nreturn M\n")
execute_process(COMMAND "${VICTUS_CLI}" export "${WORK}/export_src_2d" --out "${WORK}/export_broken" RESULT_VARIABLE rc
    OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(rc EQUAL 0 OR NOT err MATCHES "broken.luau")
    message(FATAL_ERROR "export did not fail on a broken script (${rc}): ${out}${err}")
endif()
execute_process(COMMAND "${VICTUS_CLI}" export "${WORK}/export_src_3d" RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
if(rc EQUAL 0)
    message(FATAL_ERROR "export without --out succeeded")
endif()

# World streaming (ADR-0090): partition a 3D scene into cells, check, run and export it.
set(wdir "${WORK}/world_3d")
run_ok("${VICTUS_CLI}" new "${wdir}" --template 3d --name "World 3d" --character none)
run_ok("${VICTUS_CLI}" world "${wdir}" --out worlds/main --cell-size 4)
if(NOT LAST_OUTPUT MATCHES "([0-9]+) cells, ([0-9]+) entities moved" OR CMAKE_MATCH_1 LESS 2)
    message(FATAL_ERROR "world partition produced too few cells: ${LAST_OUTPUT}")
endif()
if(NOT EXISTS "${wdir}/worlds/main.vworld")
    message(FATAL_ERROR "world partition did not write worlds/main.vworld")
endif()
run_ok("${VICTUS_CLI}" check "${wdir}")
run_ok("${VICTUS_CLI}" export "${wdir}" --out "${WORK}/world_export" --name world_game)
if(run_gpu)
    run_ok("${VICTUS_CLI}" run "${wdir}" --frames 5)
    if(NOT LAST_OUTPUT MATCHES "world: [1-9][0-9]* cells streamed in")
        message(FATAL_ERROR "victus run did not stream world cells: ${LAST_OUTPUT}")
    endif()
    file(GLOB wexe "${WORK}/world_export/world_game*")
    run_ok("${wexe}" --frames 5 --screenshot "${WORK}/world_export.png")
endif()
execute_process(COMMAND "${VICTUS_CLI}" world "${wdir}" RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
if(rc EQUAL 0)
    message(FATAL_ERROR "world without --out succeeded")
endif()

message(STATUS "CLI smoke test passed (gpu run: ${run_gpu})")
