# Crash reporting end to end: crash the CLI on purpose (null write, uncaught exception, failed
# VICTUS_VERIFY), check each left a readable report, then bundle them with `victus diagnose`
# and check the zip's contents and path redaction.
#   cmake -DVICTUS_CLI=<victus> -DWORK=<dir> -P diagnostics_smoke.cmake
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
set(DIAG "${WORK}/diag")
set(ENV{VICTUS_DIAGNOSTICS_DIR} "${DIAG}")

function(run_ok)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "command failed (${rc}): ${ARGN}\n${out}\n${err}")
    endif()
    set(LAST_OUTPUT "${out}" PARENT_SCOPE)
endfunction()

set(count 0)
foreach(kind segv terminate assert)
    execute_process(COMMAND "${VICTUS_CLI}" crash-test ${kind} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(rc EQUAL 0)
        message(FATAL_ERROR "crash-test ${kind} exited 0")
    endif()
    if(NOT err MATCHES "crash report")
        message(FATAL_ERROR "crash-test ${kind} did not announce its report:\n${err}")
    endif()
    math(EXPR count "${count} + 1")
    file(GLOB reports "${DIAG}/crashes/crash-*-victus.txt")
    list(LENGTH reports n)
    if(NOT n EQUAL count)
        message(FATAL_ERROR "expected ${count} crash reports after ${kind}, found ${n}: ${reports}")
    endif()
endforeach()

file(GLOB reports "${DIAG}/crashes/crash-*-victus.txt")
set(seen "")
foreach(r ${reports})
    file(READ "${r}" body)
    foreach(needle "VICTUS crash report" "format: 1" "app: victus" "--- backtrace ---" "--- recent log ---")
        string(FIND "${body}" "${needle}" at)
        if(at EQUAL -1)
            message(FATAL_ERROR "${r} lacks '${needle}':\n${body}")
        endif()
    endforeach()
    # At least a few frames with module offsets (" +0x").
    string(REGEX MATCHALL "\\+0x[0-9a-f]+" offsets "${body}")
    list(LENGTH offsets nframes)
    if(nframes LESS 3)
        message(FATAL_ERROR "${r} has too few frames (${nframes}):\n${body}")
    endif()
    string(REGEX MATCH "reason: [^\n]*" reason "${body}")
    string(APPEND seen "${reason}\n")
endforeach()
foreach(want "SIGSEGV" "unhandled exception: victus crash test" "SIGABRT")
    if(NOT seen MATCHES "${want}")
        message(FATAL_ERROR "no report reason matches '${want}':\n${seen}")
    endif()
endforeach()

# Crashed sessions leave their marker (the next start notices); the session logs are complete.
file(GLOB markers "${DIAG}/sessions/victus-*.running")
if(NOT markers)
    message(FATAL_ERROR "crashed sessions left no marker")
endif()
file(GLOB logs "${DIAG}/logs/victus-*.log")
if(NOT logs)
    message(FATAL_ERROR "no session log was written")
endif()

run_ok("${VICTUS_CLI}" diagnose --list)
if(NOT LAST_OUTPUT MATCHES "crash reports: 3")
    message(FATAL_ERROR "diagnose --list: ${LAST_OUTPUT}")
endif()

run_ok("${VICTUS_CLI}" new "${WORK}/game" --template 2d --name Game --character none)
run_ok("${VICTUS_CLI}" diagnose "${WORK}/game" --out "${WORK}/bundle.zip")
if(NOT LAST_OUTPUT MATCHES "3 crash reports" OR NOT LAST_OUTPUT MATCHES "nothing was uploaded")
    message(FATAL_ERROR "diagnose output: ${LAST_OUTPUT}")
endif()
file(MAKE_DIRECTORY "${WORK}/unzipped")
execute_process(COMMAND ${CMAKE_COMMAND} -E tar xf "${WORK}/bundle.zip" WORKING_DIRECTORY "${WORK}/unzipped" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "bundle.zip does not extract with cmake -E tar (${rc})")
endif()
foreach(f README.txt manifest.json system.txt project/victus.project project/validation.txt project/validation.json)
    if(NOT EXISTS "${WORK}/unzipped/${f}")
        message(FATAL_ERROR "bundle lacks ${f}")
    endif()
endforeach()
file(GLOB bundled "${WORK}/unzipped/crashes/*.txt")
list(LENGTH bundled n)
if(NOT n EQUAL 3)
    message(FATAL_ERROR "bundle has ${n} crash reports, expected 3")
endif()
file(GLOB_RECURSE all "${WORK}/unzipped/*")
foreach(f ${all})
    file(READ "${f}" body)
    string(FIND "${body}" "${WORK}/game" at)
    if(NOT at EQUAL -1)
        message(FATAL_ERROR "${f} still contains the project path")
    endif()
endforeach()
file(READ "${WORK}/unzipped/project/validation.txt" v)
if(NOT v MATCHES ": 0 problems")
    message(FATAL_ERROR "validation.txt: ${v}")
endif()

# --keep-paths and the section opt-outs.
run_ok("${VICTUS_CLI}" diagnose --out "${WORK}/small.zip" --no-crashes --no-logs --no-system)
if(NOT LAST_OUTPUT MATCHES "0 crash reports, 0 logs")
    message(FATAL_ERROR "diagnose opt-outs: ${LAST_OUTPUT}")
endif()
execute_process(COMMAND "${VICTUS_CLI}" diagnose RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
if(rc EQUAL 0)
    message(FATAL_ERROR "diagnose without --out succeeded")
endif()
execute_process(COMMAND "${VICTUS_CLI}" crash-test nothing RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
if(NOT rc EQUAL 1)
    message(FATAL_ERROR "crash-test with an unknown kind should exit 1, got ${rc}")
endif()
message(STATUS "diagnostics smoke passed")
