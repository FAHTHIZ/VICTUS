#version 450
// SPDX-License-Identifier: Apache-2.0
// Volumetric fog, pass 2 of 3 (ADR-0098): front-to-back integration of each froxel column with
// Hillaire's energy-conserving step (Frostbite 2015): within a slice of constant extinction s_t
// and in-scattering S, the light added is T * (S - S * exp(-s_t * ds)) / s_t.
// Output per froxel: vec4(scattered radiance reaching the camera from the slice's far edge, transmittance).
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#ifdef VICTUS_MSL
layout(std430, set = 0, binding = 1) readonly buffer Froxels { vec4 froxels[]; };
layout(std430, set = 1, binding = 2) buffer Integrated { vec4 integrated[]; };
#else
layout(std430, set = 0, binding = 0) readonly buffer Froxels { vec4 froxels[]; };
layout(std430, set = 1, binding = 0) buffer Integrated { vec4 integrated[]; };
#endif

// Prefix of fog_inject.comp's uniform block (the same data is pushed to both passes).
layout(std140, set = 2, binding = 0) uniform Params {
    mat4 inv_view_proj;
    mat4 prev_view_proj;
    mat4 cascade_vp[4];
    vec4 camera_pos;     // w: grid far distance
    vec4 camera_forward;
    vec4 prev_camera_pos;
    vec4 prev_camera_forward;
    vec4 grid;           // xyz froxels
} u;

void main() {
    uvec3 g = uvec3(u.grid.xyz);
    uvec2 id = gl_GlobalInvocationID.xy;
    if (id.x >= g.x || id.y >= g.y) return;
    vec2 uv = (vec2(id) + 0.5) / vec2(g.xy);
    vec4 f = u.inv_view_proj * vec4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, 1.0, 1.0);
    vec3 dir = normalize(f.xyz / f.w - u.camera_pos.xyz);
    float ray_scale = 1.0 / max(dot(dir, u.camera_forward.xyz), 1e-4); // metres along the ray per metre of depth
    float far_d = u.camera_pos.w;
    vec3 scattered = vec3(0.0);
    float transmittance = 1.0;
    float prev_depth = 0.0;
    for (uint z = 0u; z < g.z; ++z) {
        float t = float(z + 1u) / float(g.z);
        float depth = far_d * t * t;
        float ds = (depth - prev_depth) * ray_scale;
        prev_depth = depth;
        uint index = (z * g.y + id.y) * g.x + id.x;
        vec4 v = froxels[index];
        float ext = max(v.w, 0.0);
        if (ext > 1e-6) {
            float step_t = exp(-ext * ds);
            scattered += transmittance * (v.rgb - v.rgb * step_t) / ext;
            transmittance *= step_t;
        } else {
            scattered += transmittance * v.rgb * ds;
        }
        integrated[index] = vec4(scattered, transmittance);
    }
}
