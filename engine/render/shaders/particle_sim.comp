#version 450
// SPDX-License-Identifier: Apache-2.0
// GPU particle simulation (ADR-0097). One shader, two modes:
//   mode 0 (spawn):  thread i writes spawn record i into its slot and integrates it over its
//                    pre-age (the part of the frame after its birth); marks it born this frame.
//   mode 1 (update): thread i integrates slot i over the frame (unless born this frame), bounces
//                    it off the scene depth when collision is on, and writes its billboard.
// Trails (ADR-0110, trail_meta.x = points per slot > 0): both modes record the particle's position
// into its ring of trail points once it moved trail.y metres and expire points older than trail.x
// seconds (particles.cpp record_trail); mode 1 also writes the slot's ribbon strip, two edge
// vertices per point from tail to head plus the live head, in ribbon.vert's vertex layout.
// Integration, turbulence and billboard rules mirror particles::gpu_integrate/gpu_billboard.
// Bindings follow SDL_GPU compute conventions (Vulkan: set 0 sampled textures then read-only
// storage, set 1 read-write storage, set 2 uniforms; Metal: [[buffer]] uniforms first, then
// read-only storage, then read-write storage).
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct Particle {
    vec4 pos_age;  // xyz position (simulation space), w age
    vec4 vel_life; // xyz velocity, w life (dead when age >= life)
    vec4 misc;     // x rotation, y spin, z size scale, w start frame
    uvec4 meta;    // spawn: x slot; state: x birth serial
};
struct Instance {
    vec4 pos_size;
    vec4 color;
    vec4 params; // rotation, frame, grid, aspect
};

layout(set = 0, binding = 0) uniform sampler2D u_depth;
#ifdef VICTUS_MSL
layout(std430, set = 0, binding = 1) readonly buffer Spawns { Particle spawns[]; };
layout(std430, set = 1, binding = 2) buffer State { Particle state[]; };
layout(std430, set = 1, binding = 3) buffer Instances { Instance instances[]; };
layout(std430, set = 1, binding = 4) buffer Trail { vec4 trail[]; };
layout(std430, set = 1, binding = 5) buffer Ribbon { Instance ribbon[]; };
#else
layout(std430, set = 0, binding = 1) readonly buffer Spawns { Particle spawns[]; };
layout(std430, set = 1, binding = 0) buffer State { Particle state[]; };
layout(std430, set = 1, binding = 1) buffer Instances { Instance instances[]; };
layout(std430, set = 1, binding = 2) buffer Trail { vec4 trail[]; };   // xyz simulation-space position, w age
layout(std430, set = 1, binding = 3) buffer Ribbon { Instance ribbon[]; }; // (points + 1) * 2 vertices per slot
#endif
layout(std140, set = 2, binding = 0) uniform Params {
    mat4 view_proj;     // jittered camera view-projection (collision)
    mat4 inv_view_proj; // its inverse
    mat4 world;         // emitter to world (local-space emitters)
    mat4 view;          // camera view (velocity stretch)
    vec4 gravity_drag;  // xyz gravity, w drag
    vec4 turb;          // x amplitude, y wave number (rad/m), z speed (rad/s), w field phase at the end of the frame
    vec4 size;          // x size start, y size end, z intensity, w velocity stretch (s)
    vec4 color_start;
    vec4 color_end;
    vec4 flip;          // x columns, y rows, z frames used, w fps
    vec4 collide;       // x bounce, y friction, z thickness (m), w trail alpha at the tail (fraction)
    vec4 eye_dt;        // xyz camera position, w frame dt
    vec4 screen;        // xy depth size, z/w linear depth = z / (depth + w)
    uvec4 meta;         // x mode, y count, z frame serial, w flags (1 world space, 2 collision, 4 flipbook, 8 stretch, 16 textured)
    vec4 trail;         // x lifetime (s), y min distance (m), z width at the head (x size), w width at the tail (fraction)
    uvec4 trail_meta;   // x points per slot (0 = no trails)
    vec4 color_keys[8]; // ADR-0209 over-life colour gradient (particles::color_at)
    vec4 color_times[2];
    vec4 size_times[2]; // over-life size curve (particles::size_at)
    vec4 size_values[2];
    vec4 speed_times[2]; // ADR-0211 motion multipliers over life (particles::speed_at / spin_at)
    vec4 speed_values[2];
    vec4 spin_times[2];
    vec4 spin_values[2];
    uvec4 curve_meta;   // x colour keys, y size keys (0 = linear start/end), z speed keys, w spin keys (0 = 1)
} u;

float key_time(vec4 v[2], uint i) { return v[i >> 2u][i & 3u]; }

// scene::sample_gradient / sample_curve: hold the ends, linear between keys, equal times step.
vec4 color_at(float t) {
    uint n = u.curve_meta.x;
    if (n == 0u) return mix(u.color_start, u.color_end, t);
    if (!(t > key_time(u.color_times, 0u))) return u.color_keys[0];
    for (uint i = 1u; i < n; ++i) {
        float t1 = key_time(u.color_times, i);
        if (t <= t1) {
            float t0 = key_time(u.color_times, i - 1u);
            float span = t1 - t0;
            float f = span > 0.0 ? (t - t0) / span : 1.0;
            return u.color_keys[i - 1u] + (u.color_keys[i] - u.color_keys[i - 1u]) * f;
        }
    }
    return u.color_keys[n - 1u];
}

float size_at(float t) {
    uint n = u.curve_meta.y;
    if (n == 0u) return mix(u.size.x, u.size.y, t);
    float v = key_time(u.size_values, n - 1u);
    if (!(t > key_time(u.size_times, 0u))) {
        v = key_time(u.size_values, 0u);
    } else {
        for (uint i = 1u; i < n; ++i) {
            float t1 = key_time(u.size_times, i);
            if (t <= t1) {
                float t0 = key_time(u.size_times, i - 1u);
                float span = t1 - t0;
                float f = span > 0.0 ? (t - t0) / span : 1.0;
                float a = key_time(u.size_values, i - 1u);
                v = a + (key_time(u.size_values, i) - a) * f;
                break;
            }
        }
    }
    return u.size.x * v;
}

// scene::sample_curve with fallback 1 (speed and spin multipliers).
float curve_at(vec4 times[2], vec4 values[2], uint n, float t) {
    if (n == 0u) return 1.0;
    if (!(t > key_time(times, 0u))) return key_time(values, 0u);
    for (uint i = 1u; i < n; ++i) {
        float t1 = key_time(times, i);
        if (t <= t1) {
            float t0 = key_time(times, i - 1u);
            float span = t1 - t0;
            float f = span > 0.0 ? (t - t0) / span : 1.0;
            float a = key_time(values, i - 1u);
            return a + (key_time(values, i) - a) * f;
        }
    }
    return key_time(values, n - 1u);
}

const float kPi = 3.14159265358979;

vec3 curl_octave(vec3 x, float k, float ph) {
    return vec3(-cos(k * x.z + ph), -cos(k * x.x + 3.0 * ph + 1.7), -cos(k * x.y + 2.0 * ph + 4.1));
}

vec3 turbulence_at(vec3 p, float ph) {
    if (u.turb.x == 0.0) return vec3(0.0);
    // Rows of the orthonormal rotation used for the second octave (see particles.cpp).
    const vec3 r0 = vec3(0.36, 0.48, -0.8), r1 = vec3(-0.8, 0.6, 0.0), r2 = vec3(0.48, 0.64, 0.6);
    vec3 a = curl_octave(p, u.turb.y, ph);
    vec3 r = vec3(dot(r0, p), dot(r1, p), dot(r2, p));
    vec3 b = curl_octave(r, 2.13 * u.turb.y, -ph);
    vec3 bb = r0 * b.x + r1 * b.y + r2 * b.z; // transpose
    return (a + bb * 0.5) * (u.turb.x / 1.5);
}

void integrate(inout Particle p, float dt, float phase) {
    if (!(dt > 0.0)) return;
    int steps = clamp(int(ceil(dt * 30.0)), 1, 8);
    float h = dt / float(steps);
    float damping = u.gravity_drag.w > 0.0 ? exp(-u.gravity_drag.w * h) : 1.0;
    for (int i = 0; i < steps; ++i) {
        vec3 a = u.gravity_drag.xyz + turbulence_at(p.pos_age.xyz, phase);
        p.vel_life.xyz = (p.vel_life.xyz + a * h) * damping;
        float t = p.vel_life.w > 0.0 ? clamp(p.pos_age.w / p.vel_life.w, 0.0, 1.0) : 0.0; // at the step's start
        p.pos_age.xyz += p.vel_life.xyz * (curve_at(u.speed_times, u.speed_values, u.curve_meta.z, t) * h);
        p.misc.x += p.misc.y * curve_at(u.spin_times, u.spin_values, u.curve_meta.w, t) * h;
        p.pos_age.w += h;
        phase += u.turb.z * h;
    }
}

vec3 world_at(ivec2 px, float d) {
    vec2 ndc = vec2((float(px.x) + 0.5) / u.screen.x * 2.0 - 1.0, 1.0 - (float(px.y) + 0.5) / u.screen.y * 2.0);
    vec4 w = u.inv_view_proj * vec4(ndc, d, 1.0);
    return w.xyz / w.w;
}

float linear_depth(float d) { return u.screen.z / (d + u.screen.w); }

// Bounces a world-space particle off the visible surface it has just passed behind.
void collide(inout Particle p) {
    vec4 c = u.view_proj * vec4(p.pos_age.xyz, 1.0);
    if (c.w <= 0.05) return;
    vec2 ndc = c.xy / c.w;
    if (abs(ndc.x) > 1.0 || abs(ndc.y) > 1.0) return;
    ivec2 size = ivec2(u.screen.xy);
    ivec2 ip = clamp(ivec2(vec2((ndc.x * 0.5 + 0.5) * u.screen.x, (0.5 - ndc.y * 0.5) * u.screen.y)), ivec2(0), size - 1);
    float d = texelFetch(u_depth, ip, 0).r;
    if (d >= 1.0) return; // sky
    float scene = linear_depth(d);
    float gap = c.w - scene;
    if (gap < 0.0 || gap > u.collide.z) return;
    vec3 p0 = world_at(ip, d);
    // Normal from the neighbours on the same surface (the side whose depth is closer).
    ivec2 xl = clamp(ip - ivec2(1, 0), ivec2(0), size - 1), xr = clamp(ip + ivec2(1, 0), ivec2(0), size - 1);
    ivec2 yu = clamp(ip - ivec2(0, 1), ivec2(0), size - 1), yd = clamp(ip + ivec2(0, 1), ivec2(0), size - 1);
    float dl = texelFetch(u_depth, xl, 0).r, dr = texelFetch(u_depth, xr, 0).r;
    float du = texelFetch(u_depth, yu, 0).r, dd = texelFetch(u_depth, yd, 0).r;
    vec3 dx = abs(dr - d) < abs(dl - d) ? world_at(xr, dr) - p0 : p0 - world_at(xl, dl);
    vec3 dy = abs(dd - d) < abs(du - d) ? world_at(yd, dd) - p0 : p0 - world_at(yu, du);
    vec3 n = cross(dx, dy);
    if (dot(n, n) < 1e-20) return;
    n = normalize(n);
    vec3 eye = u.eye_dt.xyz;
    if (dot(n, eye - p0) < 0.0) n = -n;
    // Back onto the surface along the view ray, a hair in front of it.
    p.pos_age.xyz = eye + (p.pos_age.xyz - eye) * (scene / c.w) + n * 0.01;
    vec3 v = p.vel_life.xyz;
    float vn = dot(v, n);
    if (vn < 0.0) {
        vec3 vt = v - vn * n;
        p.vel_life.xyz = vt * (1.0 - u.collide.y) - n * (vn * u.collide.x);
    }
}

uint flipbook_frame(Particle p) {
    uint n = uint(u.flip.z);
    if (n <= 1u) return 0u;
    uint f;
    if (u.flip.w > 0.0) {
        f = uint(max(0.0, p.pos_age.w) * u.flip.w);
    } else {
        float t = p.vel_life.w > 0.0 ? clamp(p.pos_age.w / p.vel_life.w, 0.0, 1.0) : 0.0;
        f = min(n - 1u, uint(t * float(n)));
    }
    return (f + uint(p.misc.w)) % n;
}

Instance billboard(Particle p) {
    Instance o;
    o.pos_size = vec4(0.0);
    o.color = vec4(0.0);
    o.params = vec4(0.0);
    if (!(p.pos_age.w < p.vel_life.w)) return o;
    bool world_space = (u.meta.w & 1u) != 0u;
    float t = clamp(p.pos_age.w / p.vel_life.w, 0.0, 1.0);
    vec3 pos = world_space ? p.pos_age.xyz : (u.world * vec4(p.pos_age.xyz, 1.0)).xyz;
    float size = max(0.0, size_at(t) * p.misc.z);
    vec4 col = color_at(t);
    o.pos_size = vec4(pos, size);
    o.color = vec4(col.rgb * max(0.0, u.size.z), clamp(col.a, 0.0, 1.0));
    float rotation = p.misc.x, aspect = 0.0;
    if ((u.meta.w & 4u) != 0u) {
        o.params.y = float(flipbook_frame(p));
        o.params.z = u.flip.x * 16.0 + u.flip.y;
    }
    if ((u.meta.w & 8u) != 0u) {
        vec3 v = (world_space ? p.vel_life.xyz : (u.world * vec4(p.vel_life.xyz, 0.0)).xyz) *
                 curve_at(u.speed_times, u.speed_values, u.curve_meta.z, t);
        float speed = length(v);
        if (size > 0.0 && speed > 1e-6) {
            aspect = 1.0 + speed * u.size.w / size;
            rotation = atan(-v.x, v.y);
            // Aim along the on-screen motion (particles::aim_stretched).
            vec3 pv = (u.view * vec4(pos, 1.0)).xyz;
            vec3 dv = (u.view * vec4(v, 0.0)).xyz;
            float sx = dv.x * -pv.z + pv.x * dv.z, sy = dv.y * -pv.z + pv.y * dv.z;
            if (sx * sx + sy * sy < 1e-12) {
                sx = dv.x;
                sy = dv.y;
            }
            float vs = length(dv), across = sqrt(dv.x * dv.x + dv.y * dv.y);
            if (vs <= 0.0 || across <= 1e-6 * vs) {
                aspect = 1.0;
            } else {
                rotation = atan(-sx, sy);
                aspect = 1.0 + (aspect - 1.0) * (across / vs);
            }
        }
    }
    o.params.x = rotation;
    o.params.w = aspect;
    return o;
}

// Ring of trail points per slot: meta.y = recorded count, meta.z = index of the oldest, meta.w =
// points per slot it was recorded with (a different value restarts the history, like the CPU path).
void record_trail(inout Particle p, uint slot) {
    uint cap = u.trail_meta.x;
    if (cap == 0u) return;
    if (p.meta.w != cap) p.meta.yzw = uvec3(0u, 0u, cap);
    uint base = slot * cap, count = p.meta.y, start = p.meta.z;
    if (count == 0u || length(p.pos_age.xyz - trail[base + (start + count - 1u) % cap].xyz) >= u.trail.y) {
        if (count == cap) {
            start = (start + 1u) % cap;
            --count;
        }
        trail[base + (start + count) % cap] = p.pos_age;
        ++count;
    }
    while (count > 0u && p.pos_age.w - trail[base + start].w > u.trail.x) {
        start = (start + 1u) % cap;
        --count;
    }
    p.meta.y = count;
    p.meta.z = start;
}

// Point k of the strip (0 = tail), simulation space with its age; k == count is the live head.
vec4 strip_point(Particle p, uint base, uint k) {
    if (k >= p.meta.y) return p.pos_age;
    return trail[base + (p.meta.z + k) % u.trail_meta.x];
}

void write_ribbon(Particle p, uint slot, Instance head) {
    uint cap = u.trail_meta.x;
    uint base = slot * cap, out_base = slot * (cap + 1u) * 2u;
    bool alive = p.pos_age.w < p.vel_life.w && head.pos_size.w > 0.0;
    uint count = alive && p.meta.w == cap ? p.meta.y : 0u;
    // The newest recorded point may be the current position (just recorded); skip duplicates.
    uint n = count;
    if (alive && (count == 0u || length(p.pos_age.xyz - strip_point(p, base, count - 1u).xyz) > 1e-6)) ++n;
    if (n < 2u) n = 0u;
    bool world_space = (u.meta.w & 1u) != 0u;
    bool textured = (u.meta.w & 16u) != 0u;
    vec3 last = vec3(0.0);
    for (uint k = 0u; k <= cap; ++k) {
        Instance a, b;
        if (k < n) {
            vec4 q = strip_point(p, base, k);
            vec3 pos = world_space ? q.xyz : (u.world * vec4(q.xyz, 1.0)).xyz;
            vec3 prev = strip_point(p, base, k > 0u ? k - 1u : 0u).xyz, next = strip_point(p, base, min(k + 1u, n - 1u)).xyz;
            vec3 d = world_space ? next - prev : (u.world * vec4(next - prev, 0.0)).xyz;
            float len = length(d);
            vec3 tangent = len > 1e-8 ? d / len : vec3(0.0, 1.0, 0.0);
            float v = clamp((p.pos_age.w - q.w) / u.trail.x, 0.0, 1.0);
            float half_width = 0.5 * max(0.0, head.pos_size.w * max(0.0, u.trail.z) * mix(1.0, max(0.0, u.trail.w), v));
            vec4 col = vec4(head.color.rgb, head.color.a * mix(1.0, clamp(u.collide.w, 0.0, 1.0), v));
            float tv = textured ? v : 0.5;
            a.pos_size = vec4(pos, -half_width);
            b.pos_size = vec4(pos, half_width);
            a.color = b.color = col;
            a.params = b.params = vec4(tangent, tv);
            last = pos;
        } else {
            // Unused points collapse onto the last one with zero width: zero-area triangles.
            a.pos_size = b.pos_size = vec4(last, 0.0);
            a.color = b.color = vec4(0.0);
            a.params = b.params = vec4(0.0, 1.0, 0.0, 0.0);
        }
        ribbon[out_base + k * 2u] = a;
        ribbon[out_base + k * 2u + 1u] = b;
    }
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= u.meta.y) return;
    float dt = u.eye_dt.w;
    if (u.meta.x == 0u) {
        Particle s = spawns[i];
        uint slot = s.meta.x;
        float pre_age = s.pos_age.w;
        Particle p = s;
        p.pos_age.w = 0.0;
        p.meta = uvec4(u.meta.z, 0u, 0u, 0u);
        record_trail(p, slot); // birth point, as the CPU path records it
        integrate(p, pre_age, u.turb.w - u.turb.z * pre_age);
        if (pre_age > 0.0) record_trail(p, slot);
        state[slot] = p;
        return;
    }
    Particle p = state[i];
    if (dt > 0.0 && p.pos_age.w < p.vel_life.w && p.meta.x != u.meta.z) {
        integrate(p, dt, u.turb.w - u.turb.z * dt);
        if ((u.meta.w & 2u) != 0u && p.pos_age.w < p.vel_life.w) collide(p);
        if (p.pos_age.w < p.vel_life.w) record_trail(p, i);
        state[i] = p;
    }
    Instance head = billboard(p);
    instances[i] = head;
    if (u.trail_meta.x > 0u) write_ribbon(p, i, head);
}
