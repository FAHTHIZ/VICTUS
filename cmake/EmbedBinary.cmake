# cmake -DINPUT=<file> -DOUTPUT=<file.cpp> -DSYMBOL=<name> -DNAMESPACE=<ns> -P EmbedBinary.cmake
# Writes a C++ source defining `const std::uint8_t <SYMBOL>[]` and `const std::size_t <SYMBOL>Size`
# in namespace <NAMESPACE> with the bytes of <INPUT> (used for engine-embedded template assets).
foreach(var INPUT OUTPUT SYMBOL NAMESPACE)
    if(NOT DEFINED ${var})
        message(FATAL_ERROR "EmbedBinary.cmake: ${var} is required")
    endif()
endforeach()
file(READ "${INPUT}" _hex HEX)
string(LENGTH "${_hex}" _len)
math(EXPR _size "${_len} / 2")
# 32 bytes per line keeps the generated file diff- and editor-friendly.
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" _bytes "${_bytes}")
file(WRITE "${OUTPUT}.tmp"
"// Generated by cmake/EmbedBinary.cmake from ${INPUT}; do not edit.\n"
"#include <cstddef>\n#include <cstdint>\n"
"namespace ${NAMESPACE} {\n"
"extern const std::uint8_t ${SYMBOL}[];\nextern const std::size_t ${SYMBOL}Size;\n"
"alignas(16) const std::uint8_t ${SYMBOL}[] = {\n${_bytes}\n};\n"
"const std::size_t ${SYMBOL}Size = ${_size};\n"
"} // namespace ${NAMESPACE}\n")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
