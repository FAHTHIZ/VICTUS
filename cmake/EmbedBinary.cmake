# cmake -DINPUT=<file> -DOUTPUT=<file.cpp> -DSYMBOL=<name> -DNAMESPACE=<ns> [-DMODE=incbin|hex] -P EmbedBinary.cmake
# Writes a C++ source defining `std::span<const std::uint8_t> <SYMBOL>()` in namespace <NAMESPACE>
# returning the bytes of <INPUT> (engine-embedded template assets, ADR-0069 / ADR-0179).
#
# MODE=incbin (GCC/Clang): the bytes are pulled in by the assembler's `.incbin`, so multi-megabyte
# assets compile in milliseconds. MODE=hex (MSVC, which has no inline assembler on x64): a byte
# array literal. The SHA-256 of the input is written into the generated file so the object is
# rebuilt whenever the asset changes even though `.incbin` dependencies are invisible to depfiles.
foreach(var INPUT OUTPUT SYMBOL NAMESPACE)
    if(NOT DEFINED ${var})
        message(FATAL_ERROR "EmbedBinary.cmake: ${var} is required")
    endif()
endforeach()
if(NOT DEFINED MODE)
    set(MODE hex)
endif()
file(SHA256 "${INPUT}" _sha)
file(SIZE "${INPUT}" _size)
string(REPLACE "::" "_" _cname "${NAMESPACE}_${SYMBOL}")
set(_head "// Generated by cmake/EmbedBinary.cmake from ${INPUT}; do not edit.\n// sha256 ${_sha}\n#include <cstddef>\n#include <cstdint>\n#include <span>\n")
if(MODE STREQUAL "incbin")
    file(TO_CMAKE_PATH "${INPUT}" _in)
    set(_body
"#if defined(__APPLE__)
#define VICTUS_EMBED_SYM(s) \"_\" #s
#define VICTUS_EMBED_SECTION \".const_data\"
#else
#define VICTUS_EMBED_SYM(s) #s
#define VICTUS_EMBED_SECTION \".section .rodata\"
#endif
extern \"C\" const std::uint8_t ${_cname}_begin[];
extern \"C\" const std::uint8_t ${_cname}_end[];
__asm__(VICTUS_EMBED_SECTION \"\\n\"
        \".balign 16\\n\"
        VICTUS_EMBED_SYM(${_cname}_begin) \":\\n\"
        \".incbin \\\"${_in}\\\"\\n\"
        VICTUS_EMBED_SYM(${_cname}_end) \":\\n\"
        \".byte 0\\n\"
        \".text\\n\");
namespace ${NAMESPACE} {
std::span<const std::uint8_t> ${SYMBOL}() {
    static_assert(${_size}u > 0u, \"embedded asset is empty\");
    return {${_cname}_begin, static_cast<std::size_t>(${_cname}_end - ${_cname}_begin)};
}
} // namespace ${NAMESPACE}
")
else()
    file(READ "${INPUT}" _hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" _bytes "${_bytes}")
    set(_body
"namespace ${NAMESPACE} {
namespace {
alignas(16) const std::uint8_t kBytes[] = {
${_bytes}
};
} // namespace
std::span<const std::uint8_t> ${SYMBOL}() { return {kBytes, ${_size}u}; }
} // namespace ${NAMESPACE}
")
endif()
file(WRITE "${OUTPUT}.tmp" "${_head}${_body}")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
